<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="pagWeb.Master.vb" Inherits="appWEB_Distribuidos.Site1" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="stylesheet" href="<%= ResolveUrl("~/Estilos/biblioteca.css") %>" /><script src="<%= ResolveUrl("~/Scripts/biblioteca.js") %>" defer="defer"></script><asp:ContentPlaceHolder ID="head" runat="server" /></head>
<body><a class="skip-link" href="#contenido">Saltar al contenido</a><form id="form1" runat="server">
<table class="layout-table" cellpadding="0" cellspacing="0" role="presentation"><colgroup><col class="menu-column" /><col /></colgroup>
<tr><td colspan="2" class="header-cell"><header><table class="header-table" role="presentation"><tr><td class="brand-image"><img src="<%= ResolveUrl("~/Recursos/lecturae.png") %>" alt="Logotipo Lecturae" /></td><td class="brand-name">LECTURAE <span>/</span> Biblioteca</td><td class="session-cell"><strong><asp:Literal ID="litUsuario" runat="server" Mode="Encode" /></strong><br /><asp:Literal ID="litRol" runat="server" Mode="Encode" /></td><td class="user-image"><img src="<%= ResolveUrl("~/Recursos/usuario.png") %>" alt="" /></td></tr></table></header></td></tr>
<tr><td class="sidebar-cell"><nav aria-label="Menú de opciones"><table class="menu-table" role="presentation"><tr><td class="menu-title">TU BIBLIOTECA</td></tr>
<tr><td><asp:Button ID="btnMenuInicio" runat="server" Text="Inicio" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnMiBiblioteca" runat="server" Text="Mi biblioteca" CommandArgument="~/Lector/wfMiBiblioteca.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnBuscar" runat="server" Text="Buscar lectores" CommandArgument="~/Circulacion/wfLectores.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnPrestamos" runat="server" Text="Préstamos" CommandArgument="~/Circulacion/wfPrestamos.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnSolicitudes" runat="server" Text="Solicitudes y reservas" CommandArgument="~/Circulacion/wfSolicitudes.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnLibros" runat="server" Text="Libros" CommandArgument="~/Catalogo/wfLibros.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnEjemplares" runat="server" Text="Ejemplares" CommandArgument="~/Catalogo/wfEjemplares.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnAutores" runat="server" Text="Autores" CommandArgument="~/Catalogo/wfAutores.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnCategorias" runat="server" Text="Categorías" CommandArgument="~/Catalogo/wfCategorias.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnPenalizaciones" runat="server" Text="Tipos de penalización" CommandArgument="~/Administracion/wfPenalizaciones.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnCargos" runat="server" Text="Cargos y pagos" CommandArgument="~/Administracion/wfDetallePenalizaciones.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnUsuarios" runat="server" Text="Gestión de usuarios" CommandArgument="~/Administracion/wfUsuarios.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnLectoresPendientes" runat="server" Text="Lectores pendientes" CommandArgument="~/Administracion/wfLectoresPendientes.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnBitacora" runat="server" Text="Bitácora" CommandArgument="~/Administracion/wfBitacora.aspx" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
<tr><td class="menu-note">Un préstamo puede incluir varios libros.</td></tr>
<tr><td><asp:Button ID="btnSalir" runat="server" Text="Cerrar sesión" UseSubmitBehavior="false" CssClass="menu-button" /></td></tr>
</table></nav></td><td class="content-cell"><main id="contenido" tabindex="-1"><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" /></main></td></tr>
<tr><td colspan="2" class="footer-cell"><footer>Lecturae · Sistema de biblioteca</footer></td></tr></table><script>
(function () {
    var content = document.getElementById("contenido");
    var actions = {
        txtBuscar: ["btnBuscar"],
        txtLector: ["btnBuscarLector"],
        txtRetorno: ["btnCalcular"],
        txtDesde: ["btnAplicar", "btnActualizar"],
        txtHasta: ["btnAplicar", "btnActualizar"],
        txtUsuario: ["btnAplicar"],
        txtObjeto: ["btnAplicar"]
    };
    var prefix = "ContentPlaceHolder1_";
    content.addEventListener("keydown", function (event) {
        var input = event.target;
        if (event.key !== "Enter" || event.isComposing ||
            input.tagName !== "INPUT" || input.id.indexOf(prefix) !== 0) return;

        var buttons = actions[input.id.slice(prefix.length)];
        if (!buttons) return;

        for (var i = 0; i < buttons.length; i++) {
            var button = document.getElementById(prefix + buttons[i]);
            if (button && !button.disabled) {
                event.preventDefault();
                event.stopPropagation();
                button.click();
                return;
            }
        }
    }, true);
}());
</script></form></body></html>
