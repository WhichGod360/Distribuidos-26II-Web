<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>capaDAO</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\capaConexion\capaConexion.vbproj" />
    <ProjectReference Include="..\capaDatos\capaDatos.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="capaConexion" />
    <Import Include="capaDatos" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Distribuidos-26II-escritorio/Distribuidos-2026II/capaDAO/*.vb" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
