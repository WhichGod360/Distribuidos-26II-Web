<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="pagWeb.Master.vb" Inherits="appWEB_Distribuidos.Site1" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Estilos/biblioteca.css") %>" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <form id="form1" runat="server">
        <!-- Estructura con tablas HTML, siguiendo el ejemplo del curso. -->
        <table class="layout-table" cellpadding="0" cellspacing="0" role="presentation">
            <colgroup><col class="menu-column" /><col /></colgroup>
            <tr><td colspan="2" class="header-cell"><header><table class="header-table" role="presentation"><tr><td class="brand-image"><img src="<%= ResolveUrl("~/Recursos/lecturae.png") %>" alt="Logotipo Lecturae" /></td><td class="brand-name">LECTURAE <span>/</span> Biblioteca</td><td class="session-cell"><strong><asp:Literal ID="litUsuario" runat="server" Mode="Encode" Text="Invitado" /></strong><br /><asp:Literal ID="litRol" runat="server" Mode="Encode" Text="Sin sesión iniciada" /></td><td class="user-image"><img src="<%= ResolveUrl("~/Recursos/usuario.png") %>" alt="" /></td></tr></table></header></td></tr>
            <tr>
                <td class="sidebar-cell"><nav aria-label="Menú de opciones"><table class="menu-table" cellpadding="0" cellspacing="0" role="presentation"><tr><td class="menu-title">TU BIBLIOTECA</td></tr><tr><td><asp:Button ID="btnMenuInicio" runat="server" Text="Inicio" CssClass="menu-button selected" CausesValidation="false" /></td></tr>
<tr><td><asp:Button ID="btnBuscar" runat="server" Text="Buscar lectores" CssClass="menu-button" Enabled="false" ToolTip="Módulo próximamente disponible" /></td></tr>
<tr><td><asp:Button ID="btnPrestamos" runat="server" Text="Préstamos" CssClass="menu-button" Enabled="false" ToolTip="Módulo próximamente disponible" /></td></tr>
<tr><td><asp:Button ID="btnSolicitudes" runat="server" Text="Solicitudes y reservas" CssClass="menu-button" Enabled="false" ToolTip="Módulo próximamente disponible" /></td></tr>
<tr><td><asp:Button ID="btnLibros" runat="server" Text="Libros" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnEjemplares" runat="server" Text="Ejemplares" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnAutores" runat="server" Text="Autores" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnCategorias" runat="server" Text="Categorías" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnPenalizaciones" runat="server" Text="Penalizaciones" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnUsuarios" runat="server" Text="Gestión de usuarios" CssClass="menu-button" Enabled="false" ToolTip="Módulo próximamente disponible" /></td></tr>
<tr><td><asp:Button ID="btnBitacora" runat="server" Text="Bitácora" CssClass="menu-button" Enabled="false" ToolTip="Módulo próximamente disponible" /></td></tr>

                <tr><td class="menu-note">Cada préstamo corresponde a una copia física.</td></tr><tr><td><asp:Button ID="btnClave" runat="server" Text="Cambiar contraseña" CssClass="menu-button" /></td></tr><tr><td><asp:Button ID="btnSalir" runat="server" Text="Cerrar sesión" CssClass="menu-button" /></td></tr></table></nav></td>
                <td class="content-cell"><main id="contenido" tabindex="-1"><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" /></main></td>
            </tr>
            <tr><td colspan="2" class="footer-cell"><footer>Lecturae · Sistema de biblioteca</footer></td></tr>
        </table>
    </form>
</body>
</html>

