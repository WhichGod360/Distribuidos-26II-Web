<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="pagWeb.Master.vb" Inherits="appWEB_Distribuidos.Site1" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="stylesheet" href="<%= ResolveUrl("~/Estilos/biblioteca.css") %>" /><script src="<%= ResolveUrl("~/Scripts/biblioteca.js") %>" defer="defer"></script><asp:ContentPlaceHolder ID="head" runat="server" /></head>
<body><a class="skip-link" href="#contenido">Saltar al contenido</a><form id="form1" runat="server">
<table class="layout-table" cellpadding="0" cellspacing="0" role="presentation"><colgroup><col class="menu-column" /><col /></colgroup>
<tr><td colspan="2" class="header-cell"><header><table class="header-table" role="presentation"><tr><td class="brand-image"><img src="<%= ResolveUrl("~/Recursos/lecturae.png") %>" alt="Logotipo Lecturae" /></td><td class="brand-name">LECTURAE <span>/</span> Biblioteca</td><td class="session-cell"><strong><asp:Literal ID="litUsuario" runat="server" Mode="Encode" /></strong><br /><asp:Literal ID="litRol" runat="server" Mode="Encode" /></td><td class="user-image"><img src="<%= ResolveUrl("~/Recursos/usuario.png") %>" alt="" /></td></tr></table></header></td></tr>
<tr><td class="sidebar-cell"><nav aria-label="Menú de opciones"><table class="menu-table" role="presentation"><tr><td class="menu-title">TU BIBLIOTECA</td></tr>
<tr><td><asp:Button ID="btnMenuInicio" runat="server" Text="Inicio" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnMiBiblioteca" runat="server" Text="Mi biblioteca" CommandArgument="~/Lector/wfMiBiblioteca.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnBuscar" runat="server" Text="Buscar lectores" CommandArgument="~/Circulacion/wfLectores.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnPrestamos" runat="server" Text="Préstamos" CommandArgument="~/Circulacion/wfPrestamos.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnSolicitudes" runat="server" Text="Solicitudes y reservas" CommandArgument="~/Circulacion/wfSolicitudes.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnLibros" runat="server" Text="Libros" CommandArgument="~/Catalogo/wfLibros.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnEjemplares" runat="server" Text="Ejemplares" CommandArgument="~/Catalogo/wfEjemplares.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnAutores" runat="server" Text="Autores" CommandArgument="~/Catalogo/wfAutores.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnCategorias" runat="server" Text="Categorías" CommandArgument="~/Catalogo/wfCategorias.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnPenalizaciones" runat="server" Text="Tipos de penalización" CommandArgument="~/Administracion/wfPenalizaciones.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnCargos" runat="server" Text="Cargos y pagos" CommandArgument="~/Administracion/wfDetallePenalizaciones.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnUsuarios" runat="server" Text="Gestión de usuarios" CommandArgument="~/Administracion/wfUsuarios.aspx" CssClass="menu-button" /></td></tr>
<tr><td><asp:Button ID="btnBitacora" runat="server" Text="Bitácora" CommandArgument="~/Administracion/wfBitacora.aspx" CssClass="menu-button" /></td></tr>
<tr><td class="menu-note">Cada préstamo corresponde a una copia física.</td></tr>
<tr><td><asp:Button ID="btnSalir" runat="server" Text="Cerrar sesión" CssClass="menu-button" /></td></tr>
</table></nav></td><td class="content-cell"><main id="contenido" tabindex="-1"><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" /></main></td></tr>
<tr><td colspan="2" class="footer-cell"><footer>Lecturae · Sistema de biblioteca</footer></td></tr></table></form></body></html>
