<asp:Content ID="Contenido" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><h1>Ejemplares</h1><p class="page-description">Administra las copias físicas de cada libro.</p><asp:Label ID="lblMensaje" runat="server" Visible="false" role="alert" /><table class="toolbar-table" role="presentation"><tr><td><asp:Label ID="lblLibro" runat="server" Text="Libro" AssociatedControlID="ddlLibro" /><asp:DropDownList ID="ddlLibro" runat="server" CssClass="input-field" /></td><td><asp:Button ID="btnConsultar" runat="server" Text="Consultar" CssClass="button" /></td><td><asp:Button ID="btnAgregar" runat="server" Text="Agregar ejemplar" CssClass="button primary" /></td></tr></table><asp:Panel ID="pnlConfirmar" runat="server" Visible="false" CssClass="confirm-panel"><p><asp:Literal ID="litConfirmacion" runat="server" Mode="Encode" /></p><asp:Button ID="btnConfirmar" runat="server" Text="Confirmar" CssClass="button primary" /><asp:Button ID="btnCancelar" runat="server" Text="Cancelar" CssClass="button" /></asp:Panel><p class="field-help">Un ejemplar se agrega activo. Su edición consiste en activar o desactivar, igual que en escritorio. Los ejemplares con préstamos registrados conservan su historial y no pueden darse de baja.</p><div class="table-scroll"><asp:GridView ID="grvDatos" runat="server" AutoGenerateColumns="false" DataKeyNames="id_ejemplar,activo" CssClass="data-table" GridLines="None" EmptyDataText="Selecciona un libro para consultar sus ejemplares." AllowPaging="true" PageSize="15"><Columns><asp:ButtonField CommandName="Select" Text="Cambiar estado" HeaderText="Editar / desactivar" /><asp:BoundField DataField="id_ejemplar" HeaderText="ID del ejemplar" /><asp:BoundField DataField="estado" HeaderText="Estado" /></Columns></asp:GridView></div><p><asp:HyperLink ID="lnkVolver" runat="server" NavigateUrl="~/Catalogo/wfLibros.aspx" Text="Volver a libros" /></p></asp:Content>
