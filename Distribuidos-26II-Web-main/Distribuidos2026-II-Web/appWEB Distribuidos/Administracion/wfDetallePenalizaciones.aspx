<asp:Panel ID="pnlEditor" runat="server" Visible="false" CssClass="editor-panel"><h2><asp:Literal ID="litEditor" runat="server" Mode="Encode" /></h2><p class="field-help"><asp:Literal ID="litImporte" runat="server" Mode="Encode" /></p><table class="editor-table" role="presentation"><tr><td class="field-label"><asp:Label ID="lblTipo" runat="server" AssociatedControlID="ddlTipo" Text="Tipo de penalización" /></td><td><asp:DropDownList ID="ddlTipo" runat="server" CssClass="input-field" /></td></tr><tr><td class="field-label"><asp:Label ID="lblPrestamo" runat="server" AssociatedControlID="ddlPrestamo" Text="Préstamo" /></td><td><asp:DropDownList ID="ddlPrestamo" runat="server" CssClass="input-field" /></td></tr><tr><td class="field-label"><asp:Label ID="lblMotivo" runat="server" AssociatedControlID="txtMotivo" Text="Motivo" /></td><td><asp:TextBox ID="txtMotivo" runat="server" CssClass="input-field" TextMode="MultiLine" Rows="3" MaxLength="255" /></td></tr><tr><td class="field-label"><asp:Label ID="lblPago" runat="server" AssociatedControlID="ddlPago" Text="Estado de pago" /></td><td><asp:DropDownList ID="ddlPago" runat="server" CssClass="input-field"><asp:ListItem>Pendiente</asp:ListItem><asp:ListItem Value="PorRevisar">Por revisar</asp:ListItem><asp:ListItem>Pagada</asp:ListItem></asp:DropDownList></td></tr><tr><td colspan="2" class="form-actions"><asp:Button ID="btnGuardar" runat="server" Text="Guardar" CssClass="button primary" /><asp:Button ID="btnCancelar" runat="server" Text="Cancelar" CssClass="button" /></td></tr></table></asp:Panel>
