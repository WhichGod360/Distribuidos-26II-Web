<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="false" strict="false" explicit="true" targetFramework="4.7.2"/>
    <httpRuntime targetFramework="4.7.2"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-PE" uiCulture="es-PE"/>
    <authentication mode="Forms">
      <forms name="LecturaeSoapAuth" loginUrl="~/swBiblioteca.asmx" timeout="30" slidingExpiration="false" cookieless="UseCookies" protection="All"/>
    </authentication>
    <sessionState cookieName="LecturaeSoapSession" cookieless="UseCookies" timeout="30"/>
    <httpCookies httpOnlyCookies="true"/>
    <webServices>
      <protocols>
        <clear/>
        <add name="HttpSoap"/>
        <add name="HttpSoap12"/>
        <add name="HttpPostLocalhost"/>
        <add name="Documentation"/>
      </protocols>
      <soapExtensionTypes>
        <add type="webServices.ErroresSoap, webServices" priority="1" group="0"/>
      </soapExtensionTypes>
    </webServices>
    <customErrors mode="RemoteOnly"/>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SqlClient" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.6.2.0" newVersion="4.6.2.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear/>
        <add value="swBiblioteca.asmx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
